{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/overlay_timeline.schema.json",
  "title": "Overlay Timeline Plan",
  "description": "Describes overlay events positioned on a video timeline with layer order, timing, and safe-zone variants.",
  "type": "object",
  "required": ["overlays", "total_duration_sec"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "production_id": {
      "type": "string"
    },
    "total_duration_sec": {
      "type": "number",
      "minimum": 0
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["overlay_id", "shot_id", "segment_id", "start_time_sec", "end_time_sec", "layer", "spec"],
        "properties": {
          "overlay_id": {
            "type": "string",
            "description": "Unique overlay identifier"
          },
          "shot_id": {
            "type": "string",
            "description": "Canonical shot this overlay belongs to"
          },
          "segment_id": {
            "type": "string",
            "description": "Segment this overlay belongs to"
          },
          "start_time_sec": {
            "type": "number",
            "minimum": 0,
            "description": "Start time in seconds (relative to video timeline)"
          },
          "end_time_sec": {
            "type": "number",
            "minimum": 0,
            "description": "End time in seconds (relative to video timeline)"
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "description": "Z-order for compositing. Higher layers appear on top."
          },
          "spec": {
            "type": "object",
            "description": "Render spec passed to render_graphics.render_spec()",
            "required": ["layout"],
            "properties": {
              "layout": {
                "type": "string",
                "enum": ["lower_third", "key_line", "stat_callout", "side_by_side",
                         "comparison_card", "framework_3_step", "decision_tree",
                         "cost_stack", "before_after", "timeline",
                         "annotated_ui_mock", "quote_card"]
              },
              "text": { "type": "string" },
              "subtitle": { "type": "string" },
              "stat": { "type": "string" },
              "label": { "type": "string" },
              "left_title": { "type": "string" },
              "right_title": { "type": "string" }
            }
          },
          "position_16x9": {
            "type": "object",
            "description": "Position for 16:9 output (1920x1080)",
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "align": { "type": "string", "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"] }
            },
            "additionalProperties": false
          },
          "position_9x16": {
            "type": "object",
            "description": "Position for 9:16 output (1080x1920)",
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "align": { "type": "string", "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"] }
            },
            "additionalProperties": false
          },
          "animation": {
            "type": "object",
            "description": "Optional fade/transition animation",
            "properties": {
              "fade_in_sec": { "type": "number", "minimum": 0 },
              "fade_out_sec": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "artifact_path": {
            "type": "string",
            "description": "Rendered overlay artifact path (filled after rendering)"
          },
          "artifact_sha256": {
            "type": "string",
            "description": "SHA256 of rendered overlay artifact (filled after rendering)"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
